#!/usr/bin/env bash
# Maple stack control — build, enter container, start/stop the robot stack.
#
# Usage:
#   ./maple build       Build the Docker image
#   ./maple up          Start container and open an interactive shell
#   ./maple start       Run the full stack inside the container (PyLips + ROS)
#   ./maple down        Stop container and web UI

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

VERBOSE=false
CMD=""

MAPLE_DIR="${ROOT}/.maple"
UI_PID_FILE="${MAPLE_DIR}/ui.pid"
DOCKER_DIR="${ROOT}/docker"

usage() {
  cat <<EOF
Usage: $(basename "$0") {build|up|start|down} [-v]

Commands:
  build   Build the Docker image (run this before first ./maple up)
  up      Start the container and open an interactive bash shell
  start   Launch the full robot stack inside the container (PyLips + ROS)
  down    Stop the container and any host-side web UI

Options:
  -v      Verbose output (show full Docker build logs)

Inside the container:
  source install/setup.bash
  ros2 launch maple_bringup maple.launch.py
  /ws/docker/entrypoint.sh          # same as ./maple start

Endpoints when stack is running:
  PyLips face   http://localhost:8000/face/maple
  rosbridge     ws://localhost:9090
  Web UI        http://localhost:3000  (if Node.js is installed on host)
EOF
}

checkpoint() {
  echo "[maple] $*"
}

die() {
  echo "[maple] ERROR: $*" >&2
  exit 1
}

run_compose() {
  local -a cargs=(-f "${DOCKER_DIR}/docker-compose.yml")
  if [[ -e /dev/ttyUSB0 ]]; then
    cargs+=(-f "${DOCKER_DIR}/docker-compose.devices.yml")
  fi
  docker compose "${cargs[@]}" "$@"
}

ensure_executable() {
  chmod +x "${ROOT}/maple" "${DOCKER_DIR}/entrypoint.sh" 2>/dev/null || true
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    die "docker not found — install Docker Desktop or Docker Engine"
  fi
}

container_running() {
  run_compose ps --status running maple 2>/dev/null | grep -q maple
}

ensure_container() {
  if container_running; then
    return 0
  fi
  checkpoint "Starting container..."
  run_compose up -d maple
  checkpoint "Container started"
}

start_ui() {
  if [[ ! -d "${ROOT}/maple_ui-main" ]]; then
    return 0
  fi
  if ! command -v npm >/dev/null 2>&1; then
    checkpoint "Web UI skipped — npm not found on host"
    return 0
  fi

  mkdir -p "${MAPLE_DIR}"

  if [[ -f "${UI_PID_FILE}" ]] && kill -0 "$(cat "${UI_PID_FILE}")" 2>/dev/null; then
    checkpoint "Web UI already running (pid $(cat "${UI_PID_FILE}"))"
    return 0
  fi

  checkpoint "Starting web UI on http://localhost:3000 ..."
  (
    cd "${ROOT}/maple_ui-main"
    if [[ ! -d node_modules ]]; then
      npm install --silent
    fi
    npm start
  ) >> "${MAPLE_DIR}/ui.log" 2>&1 &

  echo $! > "${UI_PID_FILE}"
}

stop_ui() {
  if [[ ! -f "${UI_PID_FILE}" ]]; then
    return 0
  fi

  local pid
  pid="$(cat "${UI_PID_FILE}")"
  if kill -0 "${pid}" 2>/dev/null; then
    checkpoint "Stopping web UI (pid ${pid})..."
    kill "${pid}" 2>/dev/null || true
    pkill -P "${pid}" 2>/dev/null || true
  fi
  rm -f "${UI_PID_FILE}"
}

cmd_build() {
  ensure_executable
  require_docker

  checkpoint "Building Docker image..."
  if [[ "${VERBOSE}" == true ]]; then
    run_compose build maple
  else
    run_compose build maple
    checkpoint "Build complete — run ./maple up to enter the container"
  fi
}

cmd_up() {
  ensure_executable
  require_docker

  if ! docker image inspect maple-ros2:latest >/dev/null 2>&1; then
    checkpoint "Image not found — running build first..."
    cmd_build
  fi

  if [[ -e /dev/ttyUSB0 ]]; then
    checkpoint "Motor device /dev/ttyUSB0 detected (available inside container)"
  else
    checkpoint "No /dev/ttyUSB0 — motor control unavailable until device is connected"
  fi

  ensure_container

  checkpoint "Entering container (type 'exit' to leave — container keeps running)..."
  run_compose exec -it maple bash -lc '
    source /opt/ros/jazzy/setup.bash
    if [[ -f /ws/install/setup.bash ]]; then
      source /ws/install/setup.bash
    fi
    cd /ws
    exec bash
  '
}

cmd_start() {
  ensure_executable
  require_docker
  ensure_container

  checkpoint "Starting full stack in container (PyLips + ROS)..."
  if [[ "${VERBOSE}" == true ]]; then
    run_compose exec maple /ws/docker/entrypoint.sh
  else
    run_compose exec -d maple /ws/docker/entrypoint.sh
    sleep 3
    if run_compose logs maple 2>/dev/null | grep -q "Stack ready"; then
      checkpoint "Stack is running"
    else
      checkpoint "Stack starting — logs: docker compose -f docker/docker-compose.yml logs -f maple"
    fi
    checkpoint "PyLips face   → http://localhost:8000/face/maple"
    checkpoint "rosbridge     → ws://localhost:9090"
  fi

  start_ui
}

cmd_down() {
  checkpoint "Stopping web UI..."
  stop_ui

  if command -v docker >/dev/null 2>&1; then
    checkpoint "Stopping Docker container..."
    run_compose down --remove-orphans 2>/dev/null || true
    checkpoint "Container stopped"
  fi

  checkpoint "Stack is down"
}

# --- parse args ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    build|up|start|down|stop)
      CMD="$1"
      shift
      ;;
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "[maple] ERROR: Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

[[ -n "${CMD}" ]] || { usage; exit 1; }

case "${CMD}" in
  build)       cmd_build ;;
  up)          cmd_up ;;
  start)       cmd_start ;;
  down|stop)   cmd_down ;;
esac
