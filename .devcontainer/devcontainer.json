{
  "name": "ROS 2 Workspace",
  "build": {
    "dockerfile": "dev.Dockerfile"
  },
  "remoteUser": "developer",
  "runArgs": [
    "--pid=host",
    "--device=/dev/ttyUSB0:/dev/ttyUSB0"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "postCreateCommand": "sudo rosdep update && sudo apt-get update"
}